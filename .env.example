# 复制为仓库根目录 .env 后自己填密钥。不要提交 .env。
DASHSCOPE_API_KEY=

# 填了 DASHSCOPE_API_KEY 后会自动走千问，不必改 HENGCE_RUNNER。
# 强制罐头回放：HENGCE_RUNNER=scripted
# 强制千问：HENGCE_RUNNER=qwen
# 仍可用 Cursor：HENGCE_RUNNER=cursor 且设置 CURSOR_API_KEY

# 默认模型与北京地域兼容端点。新加坡地域把 BASE_URL 换成 intl。
# HENGCE_QWEN_MODEL=qwen3.7-flash-2026-07-15
# HENGCE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
